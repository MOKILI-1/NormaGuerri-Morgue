# MOKILI Standard .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Production builds
dist/
build/
.output/

# Environment and secrets (MOKILI Core Rule 7)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Database / SQLite local files
*.sqlite
*.sqlite3
*.db
