{
  "name": "nomarguerrie",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme souveraine de gestion du parcours funéraire — Framework MOKILI",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@nomarguerrie/web",
    "dev:api": "npm run dev --workspace=@nomarguerrie/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "keywords": [
    "mokili",
    "nomarguerrie",
    "funeraire",
    "morgue",
    "erp",
    "dossier-vivant"
  ],
  "author": "MOKILI SAS",
  "license": "UNLICENSED"
}
